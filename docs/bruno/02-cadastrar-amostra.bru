meta {
  name: Cadastrar amostra
  type: http
  seq: 2
}

post {
  url: {{base_url}}/amostras
  body: json
  auth: none
}

body:json {
  {
    "tipo": "Agua",
    "data_recebimento": "2026-08-10"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("amostra_id", res.getBody().id);
  }
}
