{
    "name": "isabella/ultralims-amostras",
    "description": "Mini-modulo de Gestao de Amostras — teste pratico Ultralims",
    "type": "project",
    "require": {
        "php": "^8.2",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8081 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
